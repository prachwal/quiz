{
  "$comment": "Module manifest for scripts/arch-audit.mjs. Rules are ordered: the first matching rule assigns a file to a module. A pattern is an exact path, a directory prefix ending in '/', or a glob (* within a segment, ** across segments). 'allow' lists the modules a module may import from (itself is always allowed); '*' means any module (tier rules still apply). 'open' modules may be imported by every module. 'incoming' restricts who may import a module. 'shared-X' is the src/shared part of module X; server modules may import shared-X of the modules they may import, frontend f-X likewise.",
  "version": 1,
  "rules": [
    { "module": "tests", "match": ["**/*.test.*", "tests/**", "src/test/**"] },
    { "module": "root", "match": ["server/app.ts", "server/mcp/index.ts", "api-src/**", "scripts/**", "src/pages/**", "src/App.tsx", "src/main.tsx", "src/components/AppLayout.tsx"] },
    { "module": "platform", "match": [
      "server/db.ts", "server/http.ts", "server/auth.ts", "server/devAuth.ts", "server/sentry.ts", "server/viewer.ts",
      "server/auth0Management.ts", "server/auth0AdminPure.ts", "server/protectedResource.ts",
      "server/apiTokens.ts", "server/routes/tokens.ts", "server/adminRepo.ts", "server/appSettingsRepo.ts"
    ] },
    { "module": "media", "match": ["server/media/**", "server/mcp/tools/media.ts"] },
    { "module": "quizzes", "match": [
      "server/quizRepo.ts", "server/attemptsRepo.ts", "server/attemptDetails.ts", "server/gradeHooks.ts", "server/gradeRegistry.ts",
      "server/routes/quizzes.ts", "server/mcp/quizTools.ts"
    ] },
    { "module": "learning", "match": [
      "server/coursesRepo.ts", "server/irregularVerbs.ts", "server/verbFilter.ts", "server/verbImageMatch.ts",
      "server/verbMedia.ts", "server/verbQuizBuilder.ts", "server/learningGradeHooks.ts", "server/lessonHooks.ts", "server/lessonRegistry.ts",
      "server/routes/learning.ts", "server/mcp/lessonTools.ts"
    ] },
    { "module": "progress", "match": ["server/progressRepo.ts", "server/reviewsRepo.ts", "server/progressHooks.ts", "server/routes/progress.ts", "server/routes/verbQuizzes.ts"] },
    { "module": "classes", "match": [
      "server/classes/**", "server/classesRepo.ts", "server/classAccess.ts", "server/routes/classes.ts",
      "server/mcp/classTools.ts", "server/mcp/tools/classes.ts", "server/mcp/tools/students.ts",
      "server/mcp/tools/assignments.ts", "server/mcp/tools/classGuards.ts", "server/userResults.ts"
    ] },
    { "module": "admin", "match": [
      "server/routes/admin.ts", "server/userAdmin.ts", "server/userAdminPure.ts", "server/systemStats.ts",
      "server/mcp/tools/admin.ts", "server/mcp/tools/users.ts", "server/mcp/tools/operations.ts"
    ] },
    { "module": "mcp-platform", "match": ["server/mcp/context.ts", "server/mcp/tools/shared.ts"] },
    { "module": "shared-media", "match": ["src/shared/media/**"] },
    { "module": "shared-platform", "match": ["src/shared/quiz/auth0Id.ts", "src/shared/quiz/maskEmail.ts", "src/shared/quiz/scoreBands.ts", "src/shared/platform/**"] },
    { "module": "shared-quizzes", "match": [
      "src/shared/quiz/engine.ts", "src/shared/quiz/schema.ts", "src/shared/quiz/sampling.ts",
      "src/shared/quiz/itemStats.ts", "src/shared/quiz/quizStats.ts", "src/shared/quiz/questionsSnapshot.ts",
      "src/shared/quiz/subjectGroups.ts"
    ] },
    { "module": "shared-learning", "match": [
      "src/shared/quiz/spaced.ts", "src/shared/quiz/weak.ts", "src/shared/quiz/lessonIntro.ts", "src/shared/quiz/verbImageAudit.ts"
    ] },
    { "module": "shared-progress", "match": ["src/shared/quiz/streaks.ts"] },
    { "module": "shared-classes", "match": ["src/shared/quiz/classAnalysis.ts", "src/shared/quiz/studentAnalysis.ts", "src/shared/quiz/csv.ts", "src/shared/quiz/userHistory.ts"] },
    { "module": "shared-types", "match": ["src/shared/quiz/types.ts"] },
    { "module": "f-media", "match": ["src/features/media/**"] },
    { "module": "f-quizzes", "match": ["src/features/quizzes/**"] },
    { "module": "f-learning", "match": ["src/features/learn/**"] },
    { "module": "f-progress", "match": ["src/features/progress/**"] },
    { "module": "f-classes", "match": ["src/features/classes/**"] },
    { "module": "f-platform", "match": ["src/features/results/useScoreColors.ts", "src/features/results/Score.tsx"] },
    { "module": "f-results", "match": ["src/features/results/**"] },
    { "module": "f-admin", "match": ["src/features/admin/**"] },
    { "module": "f-platform", "match": [
      "src/features/auth/**", "src/features/settings/**", "src/features/feedback/**", "src/features/audio/**",
      "src/app/**", "src/components/**", "src/vite-env.d.ts"
    ] }
  ],
  "allow": {
    "platform": [],
    "mcp-platform": [],
    "media": ["platform", "shared-media", "shared-platform"],
    "quizzes": ["platform", "media", "shared-quizzes", "shared-media", "shared-platform"],
    "learning": ["platform", "media", "quizzes", "shared-learning", "shared-quizzes", "shared-media", "shared-platform"],
    "progress": ["platform", "media", "quizzes", "learning", "shared-progress", "shared-learning", "shared-quizzes", "shared-media", "shared-platform"],
    "classes": ["platform", "media", "quizzes", "learning", "progress", "shared-classes", "shared-progress", "shared-learning", "shared-quizzes", "shared-media", "shared-platform"],
    "admin": ["*"],
    "root": ["*"],
    "tests": ["*"],
    "shared-platform": [],
    "shared-types": [],
    "shared-media": ["shared-platform"],
    "shared-quizzes": ["shared-platform", "shared-media"],
    "shared-learning": ["shared-platform", "shared-media", "shared-quizzes"],
    "shared-progress": ["shared-platform", "shared-media", "shared-quizzes", "shared-learning"],
    "shared-classes": ["shared-platform", "shared-media", "shared-quizzes", "shared-learning", "shared-progress"],
    "f-platform": [],
    "f-media": ["f-platform", "shared-media", "shared-platform"],
    "f-quizzes": ["f-platform", "f-media", "shared-quizzes", "shared-media", "shared-platform"],
    "f-learning": ["f-platform", "f-media", "f-quizzes", "shared-learning", "shared-quizzes", "shared-media", "shared-platform"],
    "f-progress": ["f-platform", "f-media", "f-quizzes", "f-learning", "shared-progress", "shared-learning", "shared-quizzes", "shared-media", "shared-platform"],
    "f-classes": ["f-platform", "f-media", "f-quizzes", "f-learning", "f-progress", "f-results", "shared-classes", "shared-progress", "shared-learning", "shared-quizzes", "shared-media", "shared-platform"],
    "f-results": ["f-platform", "f-media", "f-quizzes", "f-learning", "f-progress", "f-classes", "shared-classes", "shared-progress", "shared-learning", "shared-quizzes", "shared-media", "shared-platform"],
    "f-admin": ["*"]
  },
  "open": ["platform", "mcp-platform", "shared-platform", "shared-types", "f-platform"],
  "incoming": {
    "admin": ["root"],
    "f-admin": ["root"],
    "root": []
  }
}
