# Auth0 (tenant dev-4xxb1z18b3z4hc6s). None of these are secrets: the SPA uses a public client.
# Server (Vercel function): validates access tokens
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
# Postgres (Neon). On Vercel this comes from the project env; locally `vercel env pull .env.local`.
DATABASE_URL=
# Environments (docs/vercel.md, "Środowiska i bazy danych"): dev is DATABASE_URL above. The variables below
# are optional; without NEON_E2E_DATABASE_URL the destructive tests write to DATABASE_URL (dev) with a warning.
# Connection strings carry credentials: never commit values. Migrations use the direct (unpooled) host.
# e2e branch: destructive tests (npm run test:mcp / test:e2e) use these instead of DATABASE_URL for their run only.
NEON_E2E_DATABASE_URL=
NEON_E2E_DATABASE_URL_UNPOOLED=
# preview branch: used by db:migrate:preview and scripts/scrub-neon-branch.mjs preview (never by the app locally).
NEON_PREVIEW_DATABASE_URL_UNPOOLED=
# production (main): only for deliberate production migrations (db:migrate:prod -- --confirm-production) and for
# the host guards that refuse to run tests or scrubs against it.
NEON_PROD_DATABASE_URL=
NEON_PROD_DATABASE_URL_UNPOOLED=
# Personal tokens for manual checks: QZ_PREVIEW_TOKEN is valid on production, QZ_PREVIEW_BRANCH_TOKEN only on the
# preview branch (a token is stored in the database of its environment, so one does not work in another).
QZ_PREVIEW_TOKEN=
QZ_PREVIEW_BRANCH_TOKEN=
# Frontend (Vite)
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=
# Auth0 Management API (M2M "Quiz Management") - SECRET, server only
AUTH0_MGMT_CLIENT_ID=
AUTH0_MGMT_CLIENT_SECRET=
# Sentry (optional; errors are only reported when a DSN is set)
SENTRY_DSN=
VITE_SENTRY_DSN=
# Local-only login bypass (`npm run dev:full`; ignored in every deployment). Use the same random value (16+ chars) on both sides.
# Server: Authorization: Bearer <DEV_AUTH_TOKEN> acts as DEV_AUTH_USER_ID with DEV_AUTH_ROLES (admin,teacher,student).
# Frontend: VITE_DEV_AUTH_TOKEN skips the Auth0 login in `npm run dev:full` (never in a production build).
DEV_AUTH_TOKEN=
DEV_AUTH_ROLES=admin,teacher
DEV_AUTH_USER_ID=dev|local
VITE_DEV_AUTH_TOKEN=
VITE_DEV_AUTH_ROLES=admin,teacher
VITE_DEV_AUTH_USER_ID=dev|local
# Media storage (quiz and lesson images; see docs/Media-Storage-Plan.md). Secrets stay in Vercel secrets / .env.local.
# MEDIA_DRIVER: "s3" (default, needs the S3_* variables below) or "memory" (tests and test:mcp only, nothing is stored).
MEDIA_DRIVER=s3
# S3-compatible endpoint (Neon Object Storage, R2). Empty = AWS S3 at https://s3.<S3_REGION>.amazonaws.com.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
# SECRET - server only. Never commit values.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Only path-style addressing is implemented: leave empty or set "true".
S3_FORCE_PATH_STYLE=true
# Separates environments inside one bucket, e.g. dev/ (empty for production). Letters, digits, _ . - and /.
S3_KEY_PREFIX=
# Public https base URL of the bucket (used for the image URLs the app renders).
MEDIA_PUBLIC_BASE_URL=
# VITE_MEDIA_PUBLIC_BASE_URL (frontend, optional): the same public base URL as MEDIA_PUBLIC_BASE_URL. When set, the browser
# renders only images under this address (a placeholder otherwise). Unset = any https address. Build-time: redeploy after changes.
VITE_MEDIA_PUBLIC_BASE_URL=
# Per-file size limit in bytes (default 2097152 = 2 MB).
MEDIA_MAX_BYTES=2097152
# MEDIA_URL_FETCH=true lets the MCP tool media_upload_from_url fetch an image from an https address. Default off (any
# value other than exactly "true" keeps it off). Enable only after checking the connection pinning on the Vercel runtime.
MEDIA_URL_FETCH=false
# MEDIA_MEMORY_DIR (only with MEDIA_DRIVER=memory, tests): a directory where the memory driver writes its files, so two
# processes (the dev server and scripts/mcp-local-e2e.ts) see the same objects. Set by scripts/mcp-local-e2e.sh.
# MEDIA_SMOKE_ORIGIN (only `npm run media:smoke`, not read by the app): the app origin that the CORS checks send as
# Origin. The first value is used; empty = https://quiz-vercel-rho.vercel.app.
MEDIA_SMOKE_ORIGIN=
# CRON_SECRET (Vercel production secret, not for local use): guards GET /api/media/cleanup, the daily run that Vercel Cron
# calls with "Authorization: Bearer <CRON_SECRET>". Unset or empty = the endpoint answers 404. Random, 32+ bytes:
# `openssl rand -base64 32 | vercel env add CRON_SECRET production`. Redeploy after changes. See docs/vercel.md.
CRON_SECRET=
# MEDIA_CLEANUP_OWNER_FILTER (only for the e2e test; never set it in Production): the daily cleanup
# (GET /api/media/cleanup) only considers owners whose id contains this text. Unset or blank = every author. Set by
# scripts/mcp-local-e2e.sh to "mcp-e2e"; the server logs a `media.cleanup.owner_filter` warning when it is active.
