{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fabulous-dieffenbachia.netlify.app/schemas/quiz.schema.json",
  "title": "Quiz",
  "description": "Plik quizu dla `scripts/quiz-tool.mjs upload/download` i ciała POST/PUT /api/quizzes. Źródłem prawdy jest walidacja w src/shared/quiz/schema.ts i engine.ts; zgodność pilnuje tests/quizSchema.test.ts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "questions"],
  "properties": {
    "$schema": { "type": "string", "description": "Wskazanie tego schematu (np. \"./quiz.schema.json\"); serwer pomija to pole." },
    "title": { "type": "string", "minLength": 1, "maxLength": 200, "description": "Tytuł. Quiz o tym samym tytule jest przy `upload` zastępowany." },
    "description": { "type": "string", "maxLength": 2000, "default": "" },
    "difficulty": {
      "enum": ["easy", "medium", "hard", null],
      "description": "Poziom trudności; null = nie określono."
    },
    "subject": {
      "enum": ["math", "physics", "chemistry", "biology", "geography", "history", "polish", "english", "it", "other", null],
      "description": "Przedmiot, według którego quiz jest grupowany na liście; null = bez przedmiotu."
    },
    "shuffleQuestions": {
      "type": ["boolean", "null"],
      "default": null,
      "description": "null = decyduje ustawienie gracza; true/false nadpisuje je dla tego quizu."
    },
    "shuffleOptions": {
      "type": "boolean",
      "default": false,
      "description": "Losowa kolejność odpowiedzi w pytaniach single/multiple."
    },
    "sampleSize": {
      "enum": [10, 20, 30, null],
      "default": null,
      "description": "Ile pytań losować z całej puli przy każdym podejściu; null = wszystkie."
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/question" }
    }
  },
  "$defs": {
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "isCorrect"],
      "properties": {
        "text": { "type": "string", "minLength": 1, "maxLength": 500 },
        "isCorrect": { "type": "boolean" }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "prompt", "options"],
      "properties": {
        "type": {
          "enum": ["single", "multiple", "truefalse", "text"],
          "description": "single: jedna poprawna; multiple: co najmniej jedna; truefalse: dwie opcje, jedna poprawna; text: opcje to akceptowane odpowiedzi."
        },
        "prompt": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "explanation": { "type": "string", "maxLength": 2000, "default": "" },
        "points": { "type": "integer", "minimum": 1, "maximum": 100, "default": 1 },
        "options": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/option" } },
        "verbId": {
          "type": "integer",
          "minimum": 1,
          "description": "Opcjonalnie: id czasownika z katalogu - ocena pytania aktualizuje powtórki (Leitner)."
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "single" } }, "required": ["type"] },
          "then": {
            "properties": {
              "options": {
                "minItems": 2,
                "contains": { "properties": { "isCorrect": { "const": true } }, "required": ["isCorrect"] },
                "minContains": 1,
                "maxContains": 1
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "multiple" } }, "required": ["type"] },
          "then": {
            "properties": {
              "options": {
                "minItems": 2,
                "contains": { "properties": { "isCorrect": { "const": true } }, "required": ["isCorrect"] },
                "minContains": 1
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "truefalse" } }, "required": ["type"] },
          "then": {
            "properties": {
              "options": {
                "minItems": 2,
                "maxItems": 2,
                "contains": { "properties": { "isCorrect": { "const": true } }, "required": ["isCorrect"] },
                "minContains": 1,
                "maxContains": 1
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "text" } }, "required": ["type"] },
          "then": {
            "properties": {
              "options": {
                "minItems": 1,
                "items": { "properties": { "isCorrect": { "const": true } } }
              }
            }
          }
        }
      ]
    }
  }
}
