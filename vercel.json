{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build && npm run build:api",
  "outputDirectory": "dist",
  "routes": [
    { "src": "/\\.well-known/(.*)", "dest": "/api/index.mjs?__original=/.well-known/$1" },
    { "src": "/api(?:/(.*))?", "dest": "/api/index.mjs?__original=/api/$1" },
    { "handle": "filesystem" },
    { "src": "^(?!/api(?:/|$)|\\.well-known/).*$", "dest": "/index.html" }
  ]
}
