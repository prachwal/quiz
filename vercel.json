{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build && npm run build:api",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/.well-known/(.*)", "destination": "/api/index.mjs?__original=/.well-known/$1" },
    { "source": "/api", "destination": "/api/index.mjs?__original=/api" },
    { "source": "/api/(.*)", "destination": "/api/index.mjs?__original=/api/$1" },
    { "source": "/((?!api(?:/|$)|\\.well-known/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.mjs": { "maxDuration": 30 }
  }
}
