{
  "name": "quiz",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "arch:audit": "node scripts/arch-audit.mjs",
    "preview": "vite preview",
    "test:mcp": "bash scripts/mcp-local-e2e.sh",
    "test:e2e": "bash scripts/e2e-browser.sh",
    "gate": "bash scripts/gate.sh",
    "gate:fast": "bash scripts/gate.sh fast",
    "media:verb-images": "esbuild scripts/upload-verb-images.ts --bundle --platform=node --format=esm --packages=external --outfile=.upload-verb-images.mjs --log-level=error && node --env-file-if-exists=.env --env-file-if-exists=.env.local .upload-verb-images.mjs",
    "media:smoke": "esbuild scripts/media-smoke.ts --bundle --platform=node --format=esm --packages=external --outfile=.media-smoke.mjs --log-level=error && node --env-file-if-exists=.env --env-file-if-exists=.env.local .media-smoke.mjs",
    "test": "esbuild tests/*.test.ts --bundle --platform=node --format=esm --outdir=.test-build --out-extension:.js=.mjs --log-level=warning && node --test .test-build/*.mjs",
    "test:ui": "vitest run",
    "test:ui:watch": "vitest",
    "test:ui:coverage": "vitest run --coverage",
    "test:integration": "esbuild tests/integration/*.test.ts --bundle --platform=node --format=esm --outdir=.test-build --out-extension:.js=.mjs --log-level=warning && node --test .test-build/integration*.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "build:api": "esbuild api-src/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=api/index.mjs --external:pg-native --external:@sentry/node --banner:js='import { createRequire as __cr } from \"node:module\"; const require = __cr(import.meta.url);'",
    "dev:full": "npm run build:api && node scripts/dev-server.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@auth0/auth0-react": "^2.28.2",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@reduxjs/toolkit": "^2.13.0",
    "@sentry/node": "^11.8.0",
    "@sentry/react": "^11.8.0",
    "antd": "^6.6.6",
    "express": "^5.3.0",
    "express-oauth2-jwt-bearer": "^1.11.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "ajv": "^8.20.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "msw": "^3.0.3",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "browser-tabs-lock": false
  }
}
