{
  "name": "quiz",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "esbuild tests/*.test.ts --bundle --platform=node --format=esm --outdir=.test-build --out-extension:.js=.mjs --log-level=warning && node --test .test-build/*.mjs",
    "test:ui": "vitest run",
    "test:ui:watch": "vitest",
    "test:ui:coverage": "vitest run --coverage",
    "test:integration": "esbuild tests/integration/*.test.ts --bundle --platform=node --format=esm --outdir=.test-build --out-extension:.js=.mjs --log-level=warning && node --test .test-build/integration*.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@auth0/auth0-react": "^2.28.2",
    "@netlify/aws-lambda-compat": "^2.0.2",
    "@netlify/database": "^2.0.1",
    "@netlify/functions": "^6.0.2",
    "@reduxjs/toolkit": "^2.13.0",
    "@sentry/node": "^11.8.0",
    "@sentry/react": "^11.8.0",
    "antd": "^6.6.6",
    "express": "^5.3.0",
    "express-oauth2-jwt-bearer": "^1.11.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.4",
    "serverless-http": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "ajv": "^8.20.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "msw": "^3.0.3",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
